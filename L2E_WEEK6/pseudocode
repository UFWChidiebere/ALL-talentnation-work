'''question 4
SET input_string to "[(a + b) * {c - d}]"
SET stack to an empty list
SET is_balanced to True

FOR each character in input_string:
    # Push opening brackets
    IF character is '(', '[', or '{':
        APPEND character to stack
        
    # Check closing brackets
    ELSE IF character is ')', ']', or '}':
        # If a closer appears but the stack is empty, it's unbalanced
        IF stack is empty:
            SET is_balanced to False
            BREAK loop
            
        SET last_opened to REMOVE and GET last item from stack
        
        # Check for mismatches
        IF character is ')' AND last_opened is not '(':
            SET is_balanced to False
            BREAK loop
        IF character is ']' AND last_opened is not '[':
            SET is_balanced to False
            BREAK loop
        IF character is '}' AND last_opened is not '{':
            SET is_balanced to False
            BREAK loop

# Final verification: Stack must be entirely empty
IF stack is not empty:
    SET is_balanced to False

IF is_balanced is True:
    PRINT "Balanced"
ELSE:
    PRINT "Not balanced"
'''

